<?xml version="1.0" encoding="utf-8"?>
<!-- Common manifest of both variants (docs/03-architecture.md §10.1).
     LinkActivity is declared by its own ticket (M8-05). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Application lock with the platform BiometricPrompt (docs/specs/ui-ux.md §3.6, ticket M6-07). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Package visibility without QUERY_ALL_PACKAGES: launchable apps and browsers. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".SeekMindApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeekMind"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long press on the quick settings tile (docs/specs/capture.md §7). -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- The accessibility service (docs/specs/capture.md §2), bound by the system only. -->
        <service
            android:name="fr.corsicajack.seekmind.engine.capture.SeekMindAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Quick settings tile: pause and resume (docs/specs/capture.md §7), bound by the system only. -->
        <service
            android:name="fr.corsicajack.seekmind.engine.capture.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- WorkManager is initialised on demand by SeekMindApp, with the worker factory of the Hilt graph. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ML Kit telemetry (docs/specs/ocr.md §4.1, prototype S2): the transport components are
             removed in both variants. Without TransportBackendDiscovery no upload backend is
             registered, so ML Kit's usage logs are dropped before any job or alarm is scheduled.
             The classes live in a transitive runtime dependency of :engine:ocr, outside the classpath
             lint inspects: MissingClass is ignored on these removal markers only. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- Every activity of the application has a secure window (EF-PRIV-11, ticket M6-07). This
             translucent activity of Google Play services, brought by ML Kit, only shows the dialogs
             that resolve a missing Play services; the bundled ML Kit model never opens it. -->
        <activity
            android:name="com.google.android.gms.common.api.GoogleApiActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
