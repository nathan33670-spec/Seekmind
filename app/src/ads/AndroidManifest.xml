<?xml version="1.0" encoding="utf-8"?>
<!-- Variant `ads` (docs/03-architecture.md §10.2): network access is reserved to :engine:ads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declared by the ads SDK but not needed by a rewarded-only integration. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />

    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- No SDK activity before the user asks for an ad (silence réseau, EF-MON-10). -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />
        <!-- The SDK's start-up component would run at every start of the process, before any ad is
             asked for: the SDK is started by AdMobRewardProvider.prepare() instead (monetisation §3.4). -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
